<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Course Template Views                                         -->
    <!-- ============================================================ -->
    <record id="course_template_view_tree" model="ir.ui.view">
        <field name="name">elearning.course.template.tree</field>
        <field name="model">elearning.course.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="channel_type"/>
                <field name="difficulty" widget="badge"/>
                <field name="target_audience"/>
                <field name="estimated_duration"/>
                <field name="usage_count"/>
            </list>
        </field>
    </record>

    <record id="course_template_view_form" model="ir.ui.view">
        <field name="name">elearning.course.template.form</field>
        <field name="model">elearning.course.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Template Name"/></h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="channel_type"/>
                            <field name="difficulty"/>
                            <field name="target_audience"/>
                            <field name="estimated_duration"/>
                            <field name="active"/>
                        </group>
                        <group string="Statistics">
                            <field name="usage_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Learning Objectives">
                            <field name="learning_objectives"/>
                        </page>
                        <page string="Sections &amp; Content">
                            <field name="section_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="course_template_action" model="ir.actions.act_window">
        <field name="name">Course Templates</field>
        <field name="res_model">elearning.course.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_course_template"
        name="Course Templates"
        parent="website_slides.website_slides_menu_root"
        action="course_template_action"
        sequence="30"/>
</odoo>
