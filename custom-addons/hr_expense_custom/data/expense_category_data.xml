<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Expense Categories -->
        <record id="expense_category_meals" model="hr.expense.category">
            <field name="name">Repas / Meals</field>
            <field name="code">MEALS</field>
            <field name="sequence">10</field>
            <field name="max_amount">75.00</field>
            <field name="max_monthly_amount">500.00</field>
