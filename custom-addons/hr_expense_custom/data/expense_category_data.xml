            <field name="sequence">70</field>
            <field name="requires_receipt">True</field>
            <field name="requires_description">True</field>
            <field name="color">10</field>
        </record>

        <record id="expense_category_other" model="hr.expense.category">
            <field name="name">Autres / Other</field>
            <field name="code">OTHER</field>
            <field name="sequence">100</field>
            <field name="requires_receipt">True</field>
            <field name="requires_description">True</field>
            <field name="color">1</field>
        </record>
