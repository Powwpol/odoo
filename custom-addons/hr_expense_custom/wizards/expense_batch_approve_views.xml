<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="expense_batch_approve_view_form" model="ir.ui.view">
        <field name="name">hr.expense.batch.approve.form</field>
        <field name="model">hr.expense.batch.approve</field>
        <field name="arch" type="xml">
            <form string="Batch Approve Expenses">
                <group>
                    <field name="expense_count" readonly="1"/>
                    <field name="total_amount" readonly="1"/>
                </group>
                <group>
                    <field name="expense_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <group>
                    <field name="note" placeholder="Optional approval note..."/>
                    <field name="override_policy"
                        groups="hr_expense.group_hr_expense_manager"/>
                </group>
                <footer>
                    <button name="action_batch_approve" string="Approve All"
                        type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server action for batch approve from list view -->
    <record id="action_expense_batch_approve" model="ir.actions.act_window">
        <field name="name">Batch Approve</field>
        <field name="res_model">hr.expense.batch.approve</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_expense.model_hr_expense"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
