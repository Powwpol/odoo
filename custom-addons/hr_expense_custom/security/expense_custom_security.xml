<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record rules for expense categories -->
        <record id="expense_category_comp_rule" model="ir.rule">
            <field name="name">Expense Category: Company Rule</field>
            <field name="model_id" ref="model_hr_expense_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Record rules for expense policies -->
        <record id="expense_policy_comp_rule" model="ir.rule">
            <field name="name">Expense Policy: Company Rule</field>
            <field name="model_id" ref="model_hr_expense_policy"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
